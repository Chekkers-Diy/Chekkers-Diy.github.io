<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Backgammon | Chekkers DIY</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #101216;
  color: #f4f4f4;
  font-family: Arial, Helvetica, sans-serif;
}

header {
  text-align: center;
  padding: 50px 20px 30px;
  background: linear-gradient(135deg, #232831, #111317);
  border-bottom: 2px solid #bd3339;
}

h1 {
  font-size: clamp(32px, 5vw, 55px);
  margin: 8px 0;
}

.subtitle {
  color: #bbb;
  margin: 15px 0 25px;
}

nav a {
  display: inline-block;
  padding: 10px 16px;
  margin: 5px;
  color: white;
  text-decoration: none;
  border: 1px solid #555;
  border-radius: 7px;
}

nav a:hover {
  background: #30343b;
}

main {
  max-width: 1100px;
  margin: 45px auto;
  padding: 20px;
}

.intro {
  text-align: center;
  color: #bbb;
  margin-bottom: 35px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
}

.card {
  background: #1c2026;
  border: 1px solid #353b44;
  border-radius: 12px;
  overflow: hidden;
}

.card img {
  width: 100%;
  height: 220px;
  object-fit: contain;
  background: #090a0c;
  cursor: zoom-in;
}

.card h2 {
  font-size: 21px;
  margin: 18px;
}

.card p {
  color: #bbb;
  margin: 0 18px 22px;
  line-height: 1.5;
}

.viewer {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.94);
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.viewer img {
  max-width: 90vw;
  max-height: 85vh;
  object-fit: contain;
}

.close {
  position: absolute;
  top: 20px;
  right: 30px;
  font-size: 38px;
  color: white;
  cursor: pointer;
  background: none;
  border: none;
}

footer {
  text-align: center;
  padding: 40px;
  color: #999;
  border-top: 1px solid #555;
}
</style>
</head>

<body>

<header>
  <h1>BACKGAMMON</h1>
  <p class="subtitle">CHEKKERS CUSTOM CREATIONS</p>

  <nav>
    <a href="index.html">Startseite</a>
    <a href="diy-pc.html">DIY-PC</a>
    <a href="automotive.html">Automöbel</a>
  </nav>
</header>

<main>

  <div class="intro">
    <h2>Handgefertigt. Individuell. Einzigartig.</h2>
    <p>
      Selbst gefertigte Checker, Würfelbecher
      und Zubehör rund um Backgammon.
    </p>
  </div>

  <section class="grid">

    <article class="card">
      <img src="bilder/checker.jpg"
           alt="Backgammon Checker"
           onclick="showImage(this.src)">
      <h2>Checker</h2>
      <p>Individuell gefertigte Backgammon-Spielsteine.</p>
    </article>

    <article class="card">
      <img src="bilder/wuerfelbecher.jpg"
           alt="Würfelbecher"
           onclick="showImage(this.src)">
      <h2>Würfelbecher</h2>
      <p>Handgefertigte Würfelbecher in individuellem Design.</p>
    </article>

    <article class="card">
      <img src="bilder/zubehoer.jpg"
           alt="Backgammon Zubehör"
           onclick="showImage(this.src)">
      <h2>Zubehör</h2>
      <p>Praktisches und individuelles Zubehör für Backgammon.</p>
    </article>

  </section>

</main>

<div class="viewer" id="viewer" onclick="closeImage()">
  <button class="close" aria-label="Schließen">&times;</button>
  <img id="largeImage" alt="Vergrößerte Ansicht">
</div>

<footer>
  © 2026 CHEKKERS DIY · Built, not bought.
</footer>

<script>
function showImage(src) {
  document.getElementById("largeImage").src = src;
  document.getElementById("viewer").style.display = "flex";
}

function closeImage() {
  document.getElementById("viewer").style.display = "none";
}

document.addEventListener("keydown", function(e) {
  if (e.key === "Escape") closeImage();
});
</script>

</body>
</html>
